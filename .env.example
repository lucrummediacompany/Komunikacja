# Create these credentials in Coinbase Developer Platform.
# Never commit a populated .env file.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# BTC | ETH | XRP | ONDO | TZ-SELECT
TZ_PRODUCT=TZ-SELECT

# Default guardrail: at most 10 purchases ($0.30) per rolling 24 hours.
TZ_DAILY_CAP_ATOMIC=300000

# Optional for the 4H buyer. Defaults to ./data.
TZ_OUTPUT_DIR=./data
