{
  "name": "trading-zones-x402-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK and agent examples for Trading Zones paid 4H setups over x402.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run build && npm test",
    "buy:http": "tsx examples/http-buy-once.ts",
    "buy:mcp": "tsx examples/mcp-buy-once.ts",
    "bot:4h": "tsx examples/four-hour-buyer.ts"
  },
  "keywords": [
    "x402",
    "mcp",
    "ai-agents",
    "bitcoin",
    "crypto",
    "trading"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.60.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "@x402/mcp": "^2.28.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
